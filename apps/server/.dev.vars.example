# Local development secrets for `wrangler dev`.
# Copy to .dev.vars (git-ignored) and fill in fresh values. Never commit .dev.vars.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Wraps every project key. Losing it loses every secret.
ANCHOR_ROOT_KEY=

# One-time token that guards POST /api/v1/setup. Generate with: openssl rand -base64 32
# Leave empty (or remove) to disable setup.
ANCHOR_SETUP_TOKEN=
