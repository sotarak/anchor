{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily audit retention purge (src/audit/scheduled.ts).
  "triggers": { "crons": ["0 3 * * *"] },
  // The dashboard SPA (apps/web build). /api/* always reaches the Worker; any other unknown path
  // serves index.html so client-side routes deep-link. Build it first: `pnpm build` at the root.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anchor",
      // Replace with the id printed by `wrangler d1 create anchor` (see docs/deploy.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
