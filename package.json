{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sotarak/anchor.git"
  },
  "homepage": "https://sotarak.github.io/anchor/",
  "bugs": {
    "url": "https://github.com/sotarak/anchor/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @anchor/web build",
    "deploy:worker": "pnpm build && pnpm --filter ./apps/server run deploy:worker",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^5.9.3"
  }
}
